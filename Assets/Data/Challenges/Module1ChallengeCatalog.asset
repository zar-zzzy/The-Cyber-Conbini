%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49535c3d4b6acae40bf274a3826d032a, type: 3}
  m_Name: Module1ChallengeCatalog
  m_EditorClassIdentifier: CyberConbini.Runtime::CyberConbini.Gameplay.ChallengeCatalog
  moduleId: M1
  moduleTitle: "M\xF3dulo 1 \u2014 Primer turno"
  plannedChallengeCount: 6
  challenges:
  - id: M1_R1
    moduleId: M1
    title: Saludo inicial
    prompt: 'El primer cliente ha llegado. Muestra el siguiente mensaje en la terminal:'
    targetDisplayText: Bienvenido al Cyber-Conbini
    hint: 'Pista: usa print() y escribe el mensaje entre comillas.'
    expectedOutput: Bienvenido al Cyber-Conbini
    successFeedback: "\xA1Correcto! El cliente ha sido recibido."
    validationType: 0
    rules:
      variableName: 
      expectedValue: Bienvenido al Cyber-Conbini
      valueKind: 0
  - id: M1_R2
    moduleId: M1
    title: Inicio de turno
    prompt: "La tienda est\xE1 lista para atender. Muestra el siguiente mensaje en
      la terminal:"
    targetDisplayText: Turno nocturno iniciado
    hint: 'Pista: usa print() y escribe el mensaje entre comillas.'
    expectedOutput: Turno nocturno iniciado
    successFeedback: "\xA1Correcto! El turno nocturno ha comenzado."
    validationType: 0
    rules:
      variableName:
      expectedValue: Turno nocturno iniciado
      valueKind: 0
  - id: M1_R3
    moduleId: M1
    title: Producto en caja
    prompt: 'El cliente ha dejado un producto en el mostrador. Muestra el nombre del producto en la terminal:'
    targetDisplayText: Onigiri de salmón
    hint: 'Pista: usa print() y escribe el nombre del producto entre comillas.'
    expectedOutput: Onigiri de salmón
    successFeedback: "\xA1Correcto! El producto ha sido registrado."
    validationType: 0
    rules:
      variableName:
      expectedValue: Onigiri de salmón
      valueKind: 0
  - id: M1_R4
    moduleId: M1
    title: Guardar cliente
    prompt: 'La cliente se llama Aiko. Guarda su nombre en una variable llamada cliente.'
    targetDisplayText: 'cliente = "Aiko"'
    hint: 'Pista: escribe el nombre de la variable, usa = y guarda el texto entre comillas.'
    expectedOutput: Variable cliente guardada correctamente.
    successFeedback: "\xA1Correcto! El nombre de la cliente fue guardado."
    validationType: 1
    rules:
      variableName: cliente
      expectedValue: Aiko
      valueKind: 0
  - id: M1_R5
    moduleId: M1
    title: Mostrar cliente
    prompt: 'La cliente se llama Aiko. Guarda su nombre en la variable cliente y luego muéstralo en la terminal.'
    targetDisplayText: "cliente = \"Aiko\"\nprint(cliente)"
    hint: 'Pista: primero guarda el nombre usando =. En la siguiente línea usa print(cliente) sin comillas.'
    expectedOutput: Aiko
    successFeedback: "\xA1Correcto! El nombre de la cliente aparece en la terminal."
    validationType: 2
    rules:
      variableName: cliente
      expectedValue: Aiko
      valueKind: 0
  - id: M1_R6
    moduleId: M1
    title: Precio del onigiri
    prompt: 'El onigiri cuesta 450 yenes. Guarda su precio en una variable llamada precio_onigiri y luego muéstralo en la terminal.'
    targetDisplayText: "precio_onigiri = 450\nprint(precio_onigiri)"
    hint: 'Pista: los números no llevan comillas. Primero guarda 450 en precio_onigiri y luego usa print(precio_onigiri).'
    expectedOutput: 450
    successFeedback: "\xA1Correcto! Has completado el Módulo 1: Primer turno."
    validationType: 2
    rules:
      variableName: precio_onigiri
      expectedValue: 450
      valueKind: 1
