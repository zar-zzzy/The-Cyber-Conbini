# =========================================================================
# Unity .gitignore
# =========================================================================

# Unity generated folders and files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / Rider / VS Code project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & logs
sysinfo.txt
*.stackdump

# Visual Studio files
.vs/
.vscode/

# Rider files
.idea/
*.sln.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Keep .meta files for empty directories
!*.meta

# Local dev screenshots
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

